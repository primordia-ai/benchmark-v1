    # Add more priors as needed
}

DEFAULT_TOLERANCES = {
    'operating_margin': 0.05,    # 5% relative error
    'gross_margin': 0.05,
    'net_profit_margin': 0.05,

    'leverage': 0.05,
    'working_capital_ratio': 0.10,

    'roic': 0.10,
    'roe': 0.10,
    'cfroi': 0.15,

    'revenue_growth': 0.15,
    'fcf_growth': 0.20,
    'ebitda_growth': 0.20,

    'asset_turnover': 0.15,
    'reinvestment_rate': 0.15,

    'pe_ratio': 0.20,
    'ev_ebitda': 0.20,
    'pb_ratio': 0.20,

    'eva_percent': 0.25,

    'cash_conversion_cycle': 0.15
}

def infer_data(hard_indicators, soft_indicators, priors):
    hard_data = []
    soft_data = defaultdict(float)

    # Hard indicators computation
    for indicator in hard_indicators:
        value, _ = indicator[1]
        if isinstance(value, list):  # e.g., revenue growth as a percentage range
            values = [x * indicator["scale_factor"] for x in value]
            soft_data[indicator[0]] += np.mean(values)
        else:
            soft_data[indicator[0]] += value

    return hard_data, soft_data

def infer_classification(soft_data):
    # Classification scores computation based on the provided data
    classifications = {}
    for (indicator, score), _ in soft_indicators.items():
        if indicator not in classifications or score > classifications[indicator]:
            classifications[indicator] = score

    # Calculate average score
    avg_score = sum(classifications.values()) / len(classifications)

    # Determine the classification based on the average score and tolerance
    for key, value in DEFAULT_TOLERANCES.items():
        if abs(avg_score - value) < value * 0.1:  # 10% tolerance
            return "green"

    for key, value in classifications.items():
        if value > 0.8:
            return "yellow"
        else:
            return "red"

    # If none of the above conditions match, classify as red by default
    return "red"

def infer_next_action(classification):
    # Determine the next action based on the classification
    for (indicator_name), indicator in soft_indicators.items():
        if indicator["classification_score"] > 0.6 and classification == "yellow":
            return ("indicator_to_acquire", indicator_name)
        elif indicator["classification_score"] > 0.7 and classification == "green":
            # Further analysis required to classify as green
            return None

    # If no further action is needed, suggest none
    return {"indicator_to_acquire": None, "reasoning": "Classification seems robust with available data."}

def infer_priors(classification):
    if priors["market_conditions"] > 0.8:
        return "Market conditions are very favorable."
    elif priors["sector_trends"] > 0.7:
        return "Sector trends are moderately positive."

